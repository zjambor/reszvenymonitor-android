# Kiadás-aláírás — másold le `keystore.properties` néven, és töltsd ki.
# A keystore.properties gitignore-olt; a keystore-fájl maga a REPÓN KÍVÜL él.
#
# Ha ez a fájl hiányzik, a `assembleRelease` ALÁÍRATLAN APK-t készít (a debug
# build ettől függetlenül mindig működik) — így a projekt idegen gépen is
# lefordul, keystore nélkül.
#
# Új keystore készítése (a jelszót te add meg, ne kerüljön parancssor-előzménybe
# jelszó-argumentumként, ha elkerülhető):
#   keytool -genkeypair -v -keystore <útvonal>/reszvenymonitor.jks \
#           -alias reszvenymonitor -keyalg RSA -keysize 4096 -validity 10000
#
# FIGYELEM: a keystore-t ÉS a jelszavakat őrizd meg (mentés!). Elvesztésük után
# a telepített app többé nem frissíthető — csak eltávolítás + újratelepítés.

storeFile=C:/Users/<felhasznalo>/AndroidKeystores/reszvenymonitor.jks
storePassword=<keystore-jelszo>
keyAlias=reszvenymonitor
keyPassword=<kulcs-jelszo>
