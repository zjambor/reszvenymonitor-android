# A web-app config.js megfelelője — másold le `secrets.properties` néven, és töltsd ki.
# A secrets.properties gitignore-olt: a repóba kulcs NEM kerülhet.
# Az anon kulcs a lockdown óta önmagában semmire sem jogosít (lásd README — Autentikáció),
# a fegyelem ettől még marad.

SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-kulcs>

# Bejelentkezés: rövid felhasználónév → Auth-fiók e-mail leképezés.
# Jelszó ide SOHA nem kerülhet — azt a Supabase Auth szerver ellenőrzi.
APP_USER=<felhasznalonev>
APP_EMAIL=<auth-email>

START_DATE=2023-01-01
DEFAULT_TICKER=NVDA
DEFAULT_DISPLAY_CURRENCY=USD
